  "semantics": {
    "codes": "Codes and reasons match ^[A-Z][A-Z0-9_]{0,63}$; free text from the core becomes UNSTRUCTURED and never crosses the API.",
    "consistency": "PER_FIELD_NON_ATOMIC: fields are read one at a time without a runtime-wide critical section; observed_at is the read instant.",
    "freshness": {
      "max_clock_skew_s": 5.0,
      "max_snapshot_age_s": 30.0
    },
    "source": "Responses declare source=core; the simulated adapter declares source=simulated.",
    "transport": "HTTP/1.1 GET only on 127.0.0.1, Authorization Bearer token required, Host must be 127.0.0.1:<port>, no redirects, Content-Type application/json; charset=utf-8, body at most 65536 bytes.",
    "unavailable": "A field is null if and only if its name is listed in `unavailable`; a value the core does not hold is never replaced by a default."
  },
