     cap = _optional_cap(rc, name)
+    if cap["state"] == "ACTIVE" and name == "max_drawdown_hard_stop_pct" and Decimal(cap["limit"]) > 100:
+        return _p("UNKNOWN", "INVALID_LIMIT", source="CONFIG")
+    return cap
+
+
+def _breach_limit(value: object) -> str | None:
+    """Limite memorizzato nel superamento (stringa decimale del core); None se non rappresentabile."""
+    try:
+        return decimal_str(Decimal(value)) if isinstance(value, str) else None  # type: ignore[arg-type]
+    except (ArithmeticError, ValueError, _Unavailable):
+        return None
+
+
+def _drawdown_stop(rc: object, name: str) -> dict[str, Any]:
+    """PR-18 (#628-C11, #628-C11-bis): stato dell'hard-stop di drawdown letto dal DrawdownHardStop REALE del runtime.
+
+    Sola lettura: `snapshot()` e i motivi di blocco del core sotto il lock dello stop, mai `reason()`/`evaluate()`
+    (salvano il picco) né `_hard_stop()` (costruisce e rilegge lo stato). Nessuna regola parallela: il superamento è
+    quello memorizzato dal core, i motivi sono quelli del core. Lo stop percentuale vale in SIM e in LIVE (#631).
+    Ordine: stato illeggibile => UNKNOWN; superamento memorizzato di questo tipo => TRIGGERED anche se il limite è
+    stato tolto (lo sblocca solo l'owner); limite assente/non valido => INACTIVE/UNKNOWN; stato fuori ambito, picco
+    non salvato, baseline non verificata o storia insufficiente => UNKNOWN con il motivo del core (ingressi negati,
+    picco non verificabile); altrimenti ACTIVE. La cassa non verificata è una condizione del singolo ingresso, non uno
+    stato memorizzato: non compare qui."""
+    from core import drawdown_hard_stop as dd
+
+    stop = vars(rc).get("_drawdown_hard_stop")
+    if stop is None:
+        return _unknown(DRAWDOWN_SOURCE, "STATE_UNAVAILABLE")
+    lock = vars(stop).get("_lock")
+    if not _acquire(lock):
+        return _unknown(DRAWDOWN_SOURCE, "LOCK_BUSY")
+    try:
+        snap = stop.snapshot()
+        blocks = (stop.scope_block_reason(), dd.REASON_NOT_PERSISTED if snap["persist_failed"] else "",
+                  stop.baseline_block_reason(), stop.history_block_reason())
+    finally:
+        lock.release()  # type: ignore[union-attr]
+    if snap["unreadable"] is not False:
+        return _unknown(DRAWDOWN_SOURCE, _code_of(dd.REASON_STATE_UNREADABLE))
+    if snap["breached"] is True:
+        breach = snap["breach"]
+        kind = breach.get("kind")
+        if kind not in (dd.KIND_ABS, dd.KIND_PCT):
+            return _unknown(DRAWDOWN_SOURCE, "BREACH_KIND_UNKNOWN")
+        if kind == name:
+            active = dd.REASON_PCT_ACTIVE if kind == dd.KIND_PCT else dd.REASON_ACTIVE
+            return _p("TRIGGERED", _code_of(active), source=DRAWDOWN_SOURCE, limit=_breach_limit(breach.get("cap")),
+                      as_of=_epoch(breach.get("at")))
+    elif snap["breached"] is not False:
+        return _unknown(DRAWDOWN_SOURCE, "STATE_INCOHERENT")
+    cap = _drawdown_limit(rc, name)
     if cap["state"] != "ACTIVE":
         return cap
-    if _lockdown_reason(rc) == trigger:
-        return _p("TRIGGERED", trigger, source="RUNTIME", limit=cap["limit"])
-    if live_only and _execution_mode(rc) != "LIVE":
-        # Il core applica lo stop percentuale solo in LIVE (runtime_controller, Enforcement A1 #320).
-        return _p("INACTIVE", "ENFORCED_ONLY_IN_LIVE", source="CONFIG", limit=cap["limit"])
-    return cap
+    for block in blocks:
+        if block:
+            return _unknown(DRAWDOWN_SOURCE, _code_of(block))
+    return _p("ACTIVE", source=DRAWDOWN_SOURCE, limit=cap["limit"])
 
 
