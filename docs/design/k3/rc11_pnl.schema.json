{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rc11_pnl",
  "x-status": "K3_DRAFT_NOT_RATIFIED_NOT_SERVED",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "observed_at",
    "consistency",
    "state",
    "reason",
    "settlements",
    "omitted",
    "truncated"
  ],
  "properties": {
    "source": {
      "enum": [
        "core",
        "simulated"
      ]
    },
    "observed_at": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 100000000000.0
    },
    "consistency": {
      "enum": [
        "SINGLE_READ_TRANSACTION"
      ]
    },
    "state": {
      "enum": [
        "OK",
        "PARTIAL",
        "UNKNOWN",
        "UNAVAILABLE"
      ]
    },
    "reason": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "settlements": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "recorded_at",
          "outcome",
          "table_id",
          "market_id",
          "bet_id",
          "pnl",
          "realized_applied"
        ],
        "properties": {
          "recorded_at": {
            "type": "number",
            "exclusiveMinimum": 0,
            "exclusiveMaximum": 100000000000.0
          },
          "outcome": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
            "maxLength": 64
          },
          "table_id": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              {
                "type": "null"
              }
            ]
          },
          "market_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9A-Za-z._-]{1,32}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "bet_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9A-Za-z._-]{1,32}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "pnl": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?:-?[1-9][0-9]{0,14}(?:\\.[0-9]{1,28})?|0(?:\\.[0-9]{1,28})?|-0\\.[0-9]{0,27}[1-9])$",
                "maxLength": 48
              },
              {
                "type": "null"
              }
            ]
          },
          "realized_applied": {
            "type": "boolean"
          }
        }
      }
    },
    "omitted": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "truncated": {
      "type": "boolean"
    }
  }
}
